generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS (only fixed system enums remain)
// ─────────────────────────────────────────────

enum UserRole {
  admin
  operations_staff
  field_technician
  finance_manager
  vendor
  super_admin
}

enum UserStatus {
  pending_approval
  active
  inactive
}

enum FinancePreference {
  self
  govt_bank
  private_bank
}

enum LeadStatus {
  new
  in_progress
  converted
  closed
}

enum LeadClosureReason {
  not_interested
  no_roof_space
  financial_issue
  competitor
  unreachable
  other
}

enum OverpaymentRule {
  warn
  block
}

enum DocumentCategory {
  kyc
  technical
  discom
}

enum DocumentStatus {
  pending
  uploaded
}

enum TransactionType {
  customer_receipt
  vendor_payment
  subsidy
  expense
}

enum TransactionStatus {
  pending_approval
  approved
  rejected
}

enum DocType {
  upload
  generate
  view
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum OutcomeType {
  contacted
  not_reachable
  meeting_scheduled
  site_visit_done
  document_collected
  other
}

enum ProjectActivityType {
  note
  customer_contacted
  site_visit
  document_collected
  payment_received
  material_delivered
  installation_update
  inspection_done
  other
}

// ─────────────────────────────────────────────
// MASTER LOOKUP TABLES (superadmin-managed)
// ─────────────────────────────────────────────

model MasterDiscom {
  id           String          @id @default(uuid())
  districtId   String?         @map("district_id")
  district     MasterDistrict? @relation(fields: [districtId], references: [id])
  name         String          @db.VarChar(100)
  code         String          @db.VarChar(50)
  fullform     String?         @map("full_form") @db.VarChar(200)
  headquarters String?         @db.VarChar(200)
  isActive     Boolean         @default(true) @map("is_active")
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("master_discoms")
}

model MasterLeadSource {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("master_lead_sources")
}

model MasterVendorType {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("master_vendor_types")
}

model MasterPaymentMethod {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("master_payment_methods")
}

model MasterProjectType {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("master_project_types")
}

model MasterStage {
  id          String   @id @default(uuid())
  stageNumber Int      @unique @map("stage_number")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("master_stages")
}

model MasterHeadquarters {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("master_headquarters")
}

// ─────────────────────────────────────────────
// GEO MASTER TABLES
// ─────────────────────────────────────────────

model MasterState {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")

  districts  MasterDistrict[]
  leads      Lead[]
  applicants Applicant[]

  @@map("master_states")
}

model MasterDistrict {
  id        String      @id @default(uuid())
  name      String      @db.VarChar(100)
  stateId   String      @map("state_id")
  state     MasterState @relation(fields: [stateId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")

  leads         Lead[]
  applicants    Applicant[]
  discomMasters MasterDiscom[]

  @@unique([name, stateId])
  @@map("master_districts")
}

// ─────────────────────────────────────────────
// COMPANIES
// ─────────────────────────────────────────────

model Company {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(200)
  gstin          String?  @db.VarChar(15)
  addressHouse   String?  @map("address_house") @db.VarChar(200)
  addressStreet  String?  @map("address_street") @db.VarChar(200)
  addressVillage String?  @map("address_village") @db.VarChar(200)
  addressCity    String?  @map("address_city") @db.VarChar(200)
  addressPincode String?  @map("address_pincode") @db.VarChar(6)
  logoKey        String?  @map("logo_key") @db.VarChar(500)
  status         String   @default("active") @db.VarChar(20)
  settingsJson   Json?    @default("{}") @map("settings_json")
  createdAt      DateTime @default(now()) @map("created_at")

  users      User[]
  leads      Lead[]
  applicants Applicant[]
  vendors    Vendor[]

  @@map("companies")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  companyId        String     @map("company_id")
  company          Company    @relation(fields: [companyId], references: [id])
  name             String     @db.VarChar(200)
  mobile           String     @db.VarChar(10)
  email            String?    @db.VarChar(200)
  passwordHash     String?    @map("password_hash") @db.VarChar(200)
  role             UserRole
  vendorLevel           String?    @map("vendor_level") @db.VarChar(5)
  vendorId              String?    @map("vendor_id")
  vendorRef             Vendor?    @relation("VendorUsers", fields: [vendorId], references: [id])
  parentVendorUserId    String?    @map("parent_vendor_user_id")
  parentVendorUser      User?      @relation("VendorHierarchy", fields: [parentVendorUserId], references: [id])
  vendorSubUsers        User[]     @relation("VendorHierarchy")
  status           UserStatus @default(pending_approval)
  permissionsJson  Json?      @default("{}") @map("permissions_json")
  ipWhitelist      String[]   @map("ip_whitelist")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  assignedLeads        Lead[]               @relation("AssignedLeads")
  createdLeads         Lead[]               @relation("CreatedLeads")
  assignedApplicants   Applicant[]          @relation("AssignedApplicants")
  createdApplicants    Applicant[]          @relation("CreatedApplicants")
  leadFollowups        LeadFollowup[]
  projectActivities    ProjectActivity[]
  checklistItems       ApplicantChecklist[]
  statusChanges        ProjectStatusHistory[] @relation("StatusChanges")
  uploadedDocuments    Document[]
  approvedTransactions Transaction[]        @relation("ApprovedTransactions")
  createdTransactions  Transaction[]        @relation("CreatedTransactions")
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  activityLogs         UserActivityLog[]

  @@unique([companyId, mobile])
  @@map("users")
}

// ─────────────────────────────────────────────
// LEADS
// ─────────────────────────────────────────────

model Lead {
  id                   String             @id @default(uuid())
  companyId            String             @map("company_id")
  company              Company            @relation(fields: [companyId], references: [id])
  leadCode             String             @map("lead_code") @db.VarChar(20)
  customerName         String             @map("customer_name") @db.VarChar(200)
  mobile               String             @db.VarChar(10)
  alternateMobile      String?            @map("alternate_mobile") @db.VarChar(10)
  email                String?            @db.VarChar(200)
  addressHouse         String?            @map("address_house") @db.VarChar(200)
  addressStreet        String?            @map("address_street") @db.VarChar(200)
  addressVillage       String             @map("address_village") @db.VarChar(200)
  addressDistrictId    String?            @map("address_district_id")
  addressDistrict      MasterDistrict?    @relation(fields: [addressDistrictId], references: [id])
  addressStateId       String?            @map("address_state_id")
  addressState         MasterState?       @relation(fields: [addressStateId], references: [id])
  addressPincode       String?            @map("address_pincode") @db.VarChar(6)
  discom               String             @db.VarChar(50)
  projectType          String             @map("project_type") @db.VarChar(50)
  estimatedCapacityKw  Decimal?           @map("estimated_capacity_kw") @db.Decimal(6, 2)
  leadSource           String             @map("lead_source") @db.VarChar(50)
  financePreference    FinancePreference? @map("finance_preference")
  assignedStaffId      String?            @map("assigned_staff_id")
  assignedStaff        User?              @relation("AssignedLeads", fields: [assignedStaffId], references: [id])
  status               LeadStatus         @default(new)
  closureReason        LeadClosureReason? @map("closure_reason")
  followUpDate         DateTime?          @map("follow_up_date") @db.Date
  convertedApplicantId String?            @map("converted_applicant_id")
  convertedApplicant   Applicant?         @relation("ConvertedFromLead", fields: [convertedApplicantId], references: [id])
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  createdById          String             @map("created_by")
  createdBy            User               @relation("CreatedLeads", fields: [createdById], references: [id])

  followups LeadFollowup[]

  @@unique([companyId, leadCode])
  @@index([companyId, status], map: "idx_leads_company_status")
  @@index([assignedStaffId], map: "idx_leads_assigned_staff")
  @@map("leads")
}

model LeadFollowup {
  id           String      @id @default(uuid())
  leadId       String      @map("lead_id")
  lead         Lead        @relation(fields: [leadId], references: [id])
  notes        String?     @db.Text
  followUpDate DateTime?   @map("follow_up_date") @db.Date
  outcomeType  OutcomeType @map("outcome_type")
  createdById  String      @map("created_by")
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("lead_followups")
}

model ProjectActivity {
  id           String              @id @default(uuid())
  applicantId  String              @map("applicant_id")
  applicant    Applicant           @relation(fields: [applicantId], references: [id])
  activityType ProjectActivityType @map("activity_type")
  notes        String?             @db.Text
  followUpDate DateTime?           @map("follow_up_date") @db.Date
  createdById  String              @map("created_by")
  createdBy    User                @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([applicantId], map: "idx_project_activities_applicant")
  @@map("project_activities")
}

// ─────────────────────────────────────────────
// APPLICANTS
// ─────────────────────────────────────────────

model Applicant {
  id                    String          @id @default(uuid())
  companyId             String          @map("company_id")
  company               Company         @relation(fields: [companyId], references: [id])
  applicantCode         String          @map("applicant_code") @db.VarChar(20)
  discomRefNo           String?         @map("discom_ref_no") @db.VarChar(100)
  leadId                String          @map("lead_id")
  assignedStaffId       String          @map("assigned_staff_id")
  assignedStaff         User            @relation("AssignedApplicants", fields: [assignedStaffId], references: [id])
  customerName          String          @map("customer_name") @db.VarChar(200)

  mobileToken           String?         @map("mobile_token") @db.VarChar(200)
  aadhaarToken          String?         @map("aadhaar_token") @db.VarChar(200)
  panToken              String?         @map("pan_token") @db.VarChar(200)
  bankAccountToken      String?         @map("bank_account_token") @db.VarChar(200)
  signatureFileKey      String?         @map("signature_file_key") @db.VarChar(500)

  addressHouse          String?         @map("address_house") @db.VarChar(200)
  addressStreet         String?         @map("address_street") @db.VarChar(200)
  addressVillage        String?         @map("address_village") @db.VarChar(200)
  addressGp             String?         @map("address_gp") @db.VarChar(200)
  addressBlock          String?         @map("address_block") @db.VarChar(200)
  addressDistrictId     String?         @map("address_district_id")
  addressDistrict       MasterDistrict? @relation(fields: [addressDistrictId], references: [id])
  addressStateId        String?         @map("address_state_id")
  addressState          MasterState?    @relation(fields: [addressStateId], references: [id])
  addressPincode        String?         @map("address_pincode") @db.VarChar(6)
  gpsLatitude           Decimal?        @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude          Decimal?        @map("gps_longitude") @db.Decimal(10, 7)

  areaHouseNo           String?         @map("area_house_no") @db.VarChar(200)
  areaRoofSizeSqft      Decimal?        @map("area_roof_size_sqft") @db.Decimal(8, 2)
  areaNoOfFloors        Int?            @map("area_no_of_floors")
  areaRoofType          String?         @map("area_roof_type") @db.VarChar(50)
  areaHouseHeight       String?         @map("area_house_height") @db.VarChar(100)

  bankNameInAccount     String?         @map("bank_name_in_account") @db.VarChar(200)
  bankBranchName        String?         @map("bank_branch_name") @db.VarChar(200)
  bankAccountNumber     String?         @map("bank_account_number") @db.VarChar(50)
  bankIfscCode          String?         @map("bank_ifsc_code") @db.VarChar(20)
  coApplicantName       String?         @map("co_applicant_name") @db.VarChar(200)
  coApplicantRelationship String?       @map("co_applicant_relationship") @db.VarChar(100)
  coApplicantMobile     String?         @map("co_applicant_mobile") @db.VarChar(10)
  coApplicantOccupation String?         @map("co_applicant_occupation") @db.VarChar(200)

  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  gender                String?         @db.VarChar(10)
  alternateMobile       String?         @map("alternate_mobile") @db.VarChar(10)
  email                 String?         @db.VarChar(200)
  whatsappNumber        String?         @map("whatsapp_number") @db.VarChar(10)
  customerProfession    String?         @map("customer_profession") @db.VarChar(200)

  discom                String          @db.VarChar(50)
  projectType           String          @map("project_type") @db.VarChar(50)
  systemCapacityKw      Decimal?        @map("system_capacity_kw") @db.Decimal(6, 2)
  roofType              String?         @map("roof_type") @db.VarChar(50)
  sanctionedLoadKw      Decimal?        @map("sanctioned_load_kw") @db.Decimal(6, 2)
  existingConsumerNo    String?         @map("existing_consumer_no") @db.VarChar(50)

  contractAmount        Decimal?        @map("contract_amount") @db.Decimal(12, 2)
  invoiceNo             String?         @map("invoice_no") @db.VarChar(100)
  solarRate             Decimal?        @map("solar_rate") @db.Decimal(12, 2)
  solarGst              Decimal?        @map("solar_gst") @db.Decimal(5, 2)
  installationRate      Decimal?        @map("installation_rate") @db.Decimal(12, 2)
  installationGst       Decimal?        @map("installation_gst") @db.Decimal(5, 2)
  financeMode           FinancePreference? @map("finance_mode")
  bankName              String?         @map("bank_name") @db.VarChar(200)
  loanAmount            Decimal?        @map("loan_amount") @db.Decimal(12, 2)
  loanSanctionedDate    DateTime?       @map("loan_sanctioned_date") @db.Date
  overpaymentRule       OverpaymentRule @default(warn) @map("overpayment_rule")

  surveyDate            DateTime?       @map("survey_date") @db.Date
  surveyedBy            String?         @map("surveyed_by") @db.VarChar(200)
  roofAreaSqft          Decimal?        @map("roof_area_sqft") @db.Decimal(8, 2)
  shadowAnalysis        String?         @map("shadow_analysis") @db.Text
  recommendedCapacityKw Decimal?        @map("recommended_capacity_kw") @db.Decimal(6, 2)

  portalApplicationDate DateTime?       @map("portal_application_date") @db.Date
  jeName                String?         @map("je_name") @db.VarChar(200)
  jeContact             String?         @map("je_contact") @db.VarChar(10)
  mrtDate               DateTime?       @map("mrt_date") @db.Date
  inspectionDate        DateTime?       @map("inspection_date") @db.Date
  inspectionResult      String?         @map("inspection_result") @db.VarChar(50)
  netMeterSerialNo      String?         @map("net_meter_serial_no") @db.VarChar(100)

  mnreApplicationNo     String?         @map("mnre_application_no") @db.VarChar(100)
  discomApplicationNo   String?         @map("discom_application_no") @db.VarChar(100)
  mnreSubmitDate        DateTime?       @map("mnre_submit_date") @db.Date
  discomDivision        String?         @map("discom_division") @db.VarChar(200)
  discomSubDivision     String?         @map("discom_sub_division") @db.VarChar(200)
  discomSection         String?         @map("discom_section") @db.VarChar(200)
  discomContactPerson   String?         @map("discom_contact_person") @db.VarChar(200)
  discomMobileNo        String?         @map("discom_mobile_no") @db.VarChar(10)

  expectedSubsidyAmount Decimal?        @map("expected_subsidy_amount") @db.Decimal(12, 2)
  actualSubsidyReceived Decimal?        @map("actual_subsidy_received") @db.Decimal(12, 2)
  subsidyReceivedDate   DateTime?       @map("subsidy_received_date") @db.Date
  discomBankReference   String?         @map("discom_bank_reference") @db.VarChar(100)

  stage                 Int             @default(1)
  stageUpdatedAt        DateTime?       @map("stage_updated_at")
  projectStatus         String?         @map("project_status") @db.VarChar(50)
  consentGiven          Boolean         @default(false) @map("consent_given")
  consentTimestamp      DateTime?       @map("consent_timestamp")

  deletedAt             DateTime?       @map("deleted_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  createdById           String          @map("created_by")
  createdBy             User            @relation("CreatedApplicants", fields: [createdById], references: [id])

  leadsConvertedFrom    Lead[]               @relation("ConvertedFromLead")
  checklists            ApplicantChecklist[]
  documents             Document[]
  transactions          Transaction[]
  applicantVendors      ApplicantVendor[]
  customerUploadLinks   CustomerUploadLink[]
  piiVault              PiiVault?
  activities            ProjectActivity[]
  installationDetails   InstallationDetails?
  otherMaterials        OtherMaterial[]
  statusHistory         ProjectStatusHistory[]

  @@unique([companyId, applicantCode])
  @@index([companyId, stage], map: "idx_applicants_company_stage")
  @@index([discom], map: "idx_applicants_discom")
  @@map("applicants")
}

model ProjectStatusHistory {
  id          String    @id @default(uuid())
  applicantId String    @map("applicant_id")
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  status      String    @db.VarChar(50)
  changedById String    @map("changed_by_id")
  changedBy   User      @relation("StatusChanges", fields: [changedById], references: [id])
  changedAt   DateTime  @default(now()) @map("changed_at")

  @@index([applicantId], map: "idx_status_history_applicant")
  @@map("project_status_history")
}

// ─────────────────────────────────────────────
// PII VAULT
// ─────────────────────────────────────────────

model PiiVault {
  id                   String    @id @default(uuid())
  applicantId          String    @unique @map("applicant_id")
  applicant            Applicant @relation(fields: [applicantId], references: [id])
  aadhaarEncrypted     String?   @map("aadhaar_encrypted") @db.Text
  panEncrypted         String?   @map("pan_encrypted") @db.Text
  bankAccountEncrypted String?   @map("bank_account_encrypted") @db.Text
  mobileEncrypted      String?   @map("mobile_encrypted") @db.Text
  ifscCode             String?   @map("ifsc_code") @db.VarChar(11)
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("pii_vault")
}

// ─────────────────────────────────────────────
// INSTALLATION DETAILS
// ─────────────────────────────────────────────

model InstallationDetails {
  id          String    @id @default(uuid())
  applicantId String    @unique @map("applicant_id")
  applicant   Applicant @relation(fields: [applicantId], references: [id])

  // A. Dispatch
  dispatchNo               String?   @map("dispatch_no") @db.VarChar(100)
  dispatchDate             DateTime? @map("dispatch_date") @db.Date
  dispatchCustomerMobileNo String?   @map("dispatch_customer_mobile_no") @db.VarChar(15)
  vehicleNo                String?   @map("vehicle_no") @db.VarChar(50)
  driverMobileNo           String?   @map("driver_mobile_no") @db.VarChar(15)

  // B. Solar Panel
  panelBrand             String?  @map("panel_brand") @db.VarChar(100)
  panelCellManufacturer  String?  @map("panel_cell_manufacturer") @db.VarChar(100)
  panelTypeOfModule      String?  @map("panel_type_of_module") @db.VarChar(100)
  panelCapacityPerModule Decimal? @map("panel_capacity_per_module") @db.Decimal(10, 3)
  panelQty               Int?     @map("panel_qty")
  panelTotalCapacityKw   Decimal? @map("panel_total_capacity_kw") @db.Decimal(10, 3)
  panelModelType         String?  @map("panel_model_type") @db.VarChar(100)
  panelSerial1           String?  @map("panel_serial_1") @db.VarChar(100)
  panelSerial2           String?  @map("panel_serial_2") @db.VarChar(100)
  panelSerial3           String?  @map("panel_serial_3") @db.VarChar(100)
  panelSerial4           String?  @map("panel_serial_4") @db.VarChar(100)
  panelSerial5           String?  @map("panel_serial_5") @db.VarChar(100)
  panelSerial6           String?  @map("panel_serial_6") @db.VarChar(100)

  // C. Inverter
  inverterBrand         String?  @map("inverter_brand") @db.VarChar(100)
  inverterCapacityKw    Decimal? @map("inverter_capacity_kw") @db.Decimal(10, 3)
  inverterSerialNo      String?  @map("inverter_serial_no") @db.VarChar(100)
  inverterQty           Int?     @map("inverter_qty")
  inverterModelNo       String?  @map("inverter_model_no") @db.VarChar(100)
  inverterInputVoltage  String?  @map("inverter_input_voltage") @db.VarChar(50)
  inverterOutputVoltage String?  @map("inverter_output_voltage") @db.VarChar(50)

  // D. Structure
  structureGiType          String? @map("structure_gi_type") @db.VarChar(50)
  structureLegRafter       String? @map("structure_leg_rafter") @db.VarChar(50)
  structurePerlin          String? @map("structure_perlin") @db.VarChar(50)
  structureNutBoltClampBox String? @map("structure_nut_bolt_clamp_box") @db.VarChar(50)

  // E. ACDB / DCDB
  acdbModel String? @map("acdb_model") @db.VarChar(100)
  acdbSpecs String? @map("acdb_specs") @db.VarChar(100)
  acdbBrand String? @map("acdb_brand") @db.VarChar(100)
  dcdbModel String? @map("dcdb_model") @db.VarChar(100)
  dcdbSpecs String? @map("dcdb_specs") @db.VarChar(100)
  dcdbBrand String? @map("dcdb_brand") @db.VarChar(100)

  // F. Earthing Kit
  earthingLightningArrestor String? @map("earthing_lightning_arrestor") @db.VarChar(50)
  earthingChemicalBag       String? @map("earthing_chemical_bag") @db.VarChar(50)
  earthingNutBolt           String? @map("earthing_nut_bolt") @db.VarChar(50)
  earthingPitCover          String? @map("earthing_pit_cover") @db.VarChar(50)
  earthingRod               String? @map("earthing_rod") @db.VarChar(50)

  // G. PVC / Wires
  wireMc4Connector   String? @map("wire_mc4_connector") @db.VarChar(50)
  wireEarthingCable  String? @map("wire_earthing_cable") @db.VarChar(50)
  wirePvcCableTray   String? @map("wire_pvc_cable_tray") @db.VarChar(50)
  wirePvcConduitPipe String? @map("wire_pvc_conduit_pipe") @db.VarChar(50)
  wirePvcElbow       String? @map("wire_pvc_elbow") @db.VarChar(50)
  wireCClip          String? @map("wire_c_clip") @db.VarChar(50)
  wireT              String? @map("wire_t") @db.VarChar(50)
  wireFlexibleCoil   String? @map("wire_flexible_coil") @db.VarChar(50)
  wireCableTie             String? @map("wire_cable_tie") @db.VarChar(50)
  wireBlackTape            String? @map("wire_black_tape") @db.VarChar(50)
  wire16mmEarthingCable    String? @map("wire_16mm_earthing_cable") @db.VarChar(50)
  wireDcCable4sqmm         String? @map("wire_dc_cable_4sqmm") @db.VarChar(50)
  wireAcCableCopper        String? @map("wire_ac_cable_copper") @db.VarChar(50)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("installation_details")
}

model OtherMaterial {
  id          String    @id @default(uuid())
  applicantId String    @map("applicant_id")
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  itemNo      Int       @map("item_no")
  item        String    @db.VarChar(200)
  size        String?   @db.VarChar(100)
  lengthQty   String?   @map("length_qty") @db.VarChar(100)
  make        String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("other_materials")
}

// ─────────────────────────────────────────────
// CHECKLIST (global — no company scope)
// ─────────────────────────────────────────────

model ChecklistMaster {
  id          String   @id @default(uuid())
  discom      String   @db.VarChar(50)
  projectType String   @map("project_type") @db.VarChar(50)
  phaseName   String   @map("phase_name") @db.VarChar(100)
  phaseOrder  Int      @map("phase_order")
  itemText    String   @map("item_text") @db.Text
  itemOrder   Int      @map("item_order")
  isMandatory Boolean  @default(false) @map("is_mandatory")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  applicantChecklists ApplicantChecklist[]

  @@map("checklist_master")
}

model ApplicantChecklist {
  id            String          @id @default(uuid())
  applicantId   String          @map("applicant_id")
  applicant     Applicant       @relation(fields: [applicantId], references: [id])
  masterItemId  String          @map("master_item_id")
  masterItem    ChecklistMaster @relation(fields: [masterItemId], references: [id])
  isCompleted   Boolean         @default(false) @map("is_completed")
  completedById String?         @map("completed_by")
  completedBy   User?           @relation(fields: [completedById], references: [id])
  completedAt   DateTime?       @map("completed_at")
  notes         String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([applicantId, masterItemId])
  @@map("applicant_checklists")
}

// ─────────────────────────────────────────────
// DOCUMENT MASTER (global — no company scope)
// ─────────────────────────────────────────────

model DocumentMaster {
  id             String   @id @default(uuid())
  discom         String?  @db.VarChar(50)
  title          String   @db.VarChar(200)
  docType        DocType  @default(upload) @map("doc_type")
  sortOrder      Int      @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  isCommon       Boolean  @default(false) @map("is_common")
  masterFilePath  String?  @map("master_file_path") @db.VarChar(500)
  masterFileMime  String?  @map("master_file_mime") @db.VarChar(100)
  templateContent Json?    @map("template_content")
  createdAt       DateTime @default(now()) @map("created_at")

  documents Document[]

  @@index([discom], map: "idx_doc_master_discom")
  @@map("document_master")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id            String           @id @default(uuid())
  applicantId   String           @map("applicant_id")
  applicant     Applicant        @relation(fields: [applicantId], references: [id])
  masterItemId  String?          @map("master_item_id")
  masterItem    DocumentMaster?  @relation(fields: [masterItemId], references: [id])
  category      DocumentCategory
  docName       String           @map("doc_name") @db.VarChar(200)
  fileKey       String?          @map("file_key") @db.VarChar(500)
  fileName      String?          @map("file_name") @db.VarChar(200)
  fileSizeBytes Int?             @map("file_size_bytes")
  mimeType      String?          @map("mime_type") @db.VarChar(50)
  status        DocumentStatus   @default(pending)
  uploadedById  String?          @map("uploaded_by")
  uploadedBy    User?            @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime?        @map("uploaded_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([applicantId], map: "idx_documents_applicant")
  @@map("documents")
}

// ─────────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────────

model Transaction {
  id              String            @id @default(uuid())
  applicantId     String            @map("applicant_id")
  applicant       Applicant         @relation(fields: [applicantId], references: [id])
  type            TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  paymentMethod   String            @map("payment_method") @db.VarChar(50)
  transactionDate DateTime          @map("transaction_date") @db.Date
  description     String?           @db.Text
  referenceNumber String?           @map("reference_number") @db.VarChar(100)
  fileKey         String?           @map("file_key") @db.VarChar(500)
  status          TransactionStatus @default(pending_approval)
  approvedById    String?           @map("approved_by")
  approvedBy      User?             @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  approvedAt      DateTime?         @map("approved_at")
  rejectionReason String?           @map("rejection_reason") @db.Text
  vendorId        String?           @map("vendor_id")
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  createdById     String            @map("created_by")
  createdBy       User              @relation("CreatedTransactions", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([applicantId], map: "idx_transactions_applicant")
  @@map("transactions")
}

// ─────────────────────────────────────────────
// VENDORS
// ─────────────────────────────────────────────

model Vendor {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  company          Company   @relation(fields: [companyId], references: [id])
  businessName     String    @map("business_name") @db.VarChar(200)
  contactPerson    String?   @map("contact_person") @db.VarChar(200)
  mobile           String?   @db.VarChar(10)
  email            String?   @db.VarChar(200)
  addressHouse     String?   @map("address_house") @db.VarChar(200)
  addressStreet    String?   @map("address_street") @db.VarChar(200)
  addressVillage   String?   @map("address_village") @db.VarChar(200)
  addressDistrict  String?   @map("address_district") @db.VarChar(100)
  addressState     String?   @map("address_state") @db.VarChar(100)
  addressPincode   String?   @map("address_pincode") @db.VarChar(6)
  vendorTypes      String[]  @map("vendor_types")
  gstin            String?   @db.VarChar(15)
  panToken         String?   @map("pan_token") @db.VarChar(200)
  bankAccountToken String?   @map("bank_account_token") @db.VarChar(200)
  ifscCode         String?   @map("ifsc_code") @db.VarChar(11)
  empanelmentDate  DateTime? @map("empanelment_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  applicantVendors ApplicantVendor[]
  transactions     Transaction[]
  vendorUsers      User[]            @relation("VendorUsers")

  @@map("vendors")
}

model ApplicantVendor {
  id            String    @id @default(uuid())
  applicantId   String    @map("applicant_id")
  applicant     Applicant @relation(fields: [applicantId], references: [id])
  vendorId      String    @map("vendor_id")
  vendor        Vendor    @relation(fields: [vendorId], references: [id])
  categoryLabel String?   @map("category_label") @db.VarChar(100)
  isPrimary     Boolean   @default(false) @map("is_primary")
  assignedAt    DateTime  @default(now()) @map("assigned_at")

  @@unique([applicantId, vendorId])
  @@map("applicant_vendors")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String      @map("entity_id")
  action     AuditAction
  beforeJson Json?       @map("before_json")
  afterJson  Json?       @map("after_json")
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  companyId  String      @map("company_id")
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash") @db.VarChar(200)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model OtpAttempt {
  id        String    @id @default(uuid())
  mobile    String?   @db.VarChar(10)
  email     String?   @db.VarChar(200)
  otpHash   String    @map("otp_hash") @db.VarChar(200)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("otp_attempts")
}

// ─────────────────────────────────────────────
// USER ACTIVITY LOGS
// ─────────────────────────────────────────────

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  companyId   String?  @map("company_id")
  action      String   @db.VarChar(100)
  module      String?  @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  method      String?  @db.VarChar(10)
  path        String?  @db.VarChar(300)
  statusCode  Int?     @map("status_code")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_activity_log_user")
  @@index([companyId, createdAt(sort: Desc)], map: "idx_activity_log_company_date")
  @@index([createdAt(sort: Desc)], map: "idx_activity_log_date")
  @@map("user_activity_logs")
}

// ─────────────────────────────────────────────
// CUSTOMER UPLOAD LINKS
// ─────────────────────────────────────────────

model CustomerUploadLink {
  id          String    @id @default(uuid())
  applicantId String    @map("applicant_id")
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  token       String    @unique @db.VarChar(200)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], map: "idx_upload_links_expires")
  @@map("customer_upload_links")
}
